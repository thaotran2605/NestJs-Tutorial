# Application
NODE_ENV=development
PORT=3000

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_DATABASE=conduit
DB_TEST_DATABASE=conduit_test

# Redis Cache & Blacklist
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=24h
